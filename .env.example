# ============ 火山方舟（Volcengine Ark）Responses API ============
# 在 https://console.volcengine.com/ark 控制台「API Key 管理」创建
ARK_API_KEY=your-ark-api-key
# 一般保持默认，如需替换区域或模型可修改
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-1-pro-260628

# ============ Supabase ============
# Project Settings → API 中的 Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API 中的 service_role key（仅服务端使用，切勿下发到浏览器）
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============ 本地运行端口 ============
PORT=3000
